<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <RootNamespace>HamJi</RootNamespace>
    <AssemblyName>HamJi</AssemblyName>
    <ApplicationId>com.hamji.app</ApplicationId>
    <ApplicationTitle>Ham记</ApplicationTitle>
    <ApplicationVersion>11</ApplicationVersion>
    <ApplicationDisplayVersion>1.6.0</ApplicationDisplayVersion>

    <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>

    <!-- 原生库随安装解压（extractNativeLibs=true）：兼容 Android 15+ / 16KB 页，
         避免 compressed .so + direct-mmap 组合在部分机型上 dlopen 失败 -->
    <AndroidUseLegacyPackaging>true</AndroidUseLegacyPackaging>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
    <AndroidUseAapt2>true</AndroidUseAapt2>

    <!-- 裁剪改成 partial：Release 下不再对 BCL 做激进裁剪 -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>

    <DebuggerSupport>false</DebuggerSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <PublishTrimmed>false</PublishTrimmed>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

</Project>
